# Pre-packaged Pure Python 3.14 Base Image (Standard Base)
# Only pre-installs heavy Python dependencies and system build libraries (No UI, No Repo Clone)
FROM python:3.14

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    default-libmysqlclient-dev \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pre-install heavy PyPI dependencies into base image layer
RUN pip install --no-cache-dir \
    duckdb lancedb pyarrow pandas numpy scipy \
    langchain langchain-core langchain-openai langgraph \
    fastapi uvicorn starlette pydantic pymysql mysqlclient mcp \
    sqlglot boto3 opendal requests python-dotenv pyyaml jinja2 \
    clickhouse-connect databricks-sdk databricks-sql-connector \
    google-cloud-bigquery google-auth \
    && apt-get purge -y --auto-remove build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/* /tmp/* /root/.cache
