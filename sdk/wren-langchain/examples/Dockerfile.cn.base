# Pre-packaged Pure Python 3.14 Base Image (CN Accelerated Base)
# Only pre-installs heavy Python dependencies and system build libraries (No UI, No Repo Clone)
FROM python:3.14

WORKDIR /app

# Configure APT to allow HTTPS connections prior to ca-certificates installation (Tencent Cloud Mirror)
RUN echo 'Acquire::https::Verify-Peer "false";' > /etc/apt/apt.conf.d/99ssl-trust && \
    echo 'Acquire::https::Verify-Host "false";' >> /etc/apt/apt.conf.d/99ssl-trust && \
    (sed -i 's/http:\/\//https:\/\//g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) && \
    (sed -i 's/deb.debian.org/mirrors.cloud.tencent.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) && \
    (sed -i 's/deb.debian.org/mirrors.cloud.tencent.com/g' /etc/apt/sources.list 2>/dev/null || true)

# Configure PIP to use Tencent Cloud & Aliyun mirrors with prefer-binary flag
ENV PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
ENV PIP_EXTRA_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_PREFER_BINARY=true

# Install build-essential, pkg-config, default-libmysqlclient-dev, and git for C-extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    default-libmysqlclient-dev \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pre-install heavy PyPI dependencies into base image layer
RUN pip install --no-cache-dir --prefer-binary \
    -i https://mirrors.cloud.tencent.com/pypi/simple \
    duckdb lancedb pyarrow pandas numpy scipy \
    langchain langchain-core langchain-openai langgraph \
    fastapi uvicorn starlette pydantic pymysql mysqlclient mcp \
    sqlglot boto3 opendal requests python-dotenv pyyaml jinja2 \
    clickhouse-connect databricks-sdk databricks-sql-connector \
    google-cloud-bigquery google-auth \
    && apt-get purge -y --auto-remove build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/* /tmp/* /root/.cache
