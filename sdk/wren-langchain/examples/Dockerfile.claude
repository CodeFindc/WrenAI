# Containerized Claude CLI for Automated Data Source Onboarding & MDL Generation (Standard)
# Inherits pre-packaged Base Image (FROM wrenai-base:latest)
FROM wrenai-base:latest

WORKDIR /app

# Install Node.js 20 & Claude Code CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

# Pre-install SQLAlchemy and additional database drivers for schema discovery
RUN pip install --no-cache-dir \
    sqlalchemy psycopg2-binary pymysql mysqlclient duckdb clickhouse-connect

# Copy entrypoint.claude.sh from repo build context into target directory
COPY sdk/wren-langchain/examples/entrypoint.claude.sh /app/sdk/wren-langchain/examples/entrypoint.claude.sh

WORKDIR /app/sdk/wren-langchain/examples
RUN chmod +x entrypoint.claude.sh

EXPOSE 8201 8202

ENTRYPOINT ["./entrypoint.claude.sh"]
CMD ["python3", "start_dual_services.py"]
