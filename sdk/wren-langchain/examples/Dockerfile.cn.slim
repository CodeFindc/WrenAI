# Stage 1: Build the frontend chat UI (CN Accelerated Slim Base)
FROM node:20-slim AS frontend-builder

WORKDIR /app

# Configure APT to allow HTTPS connections prior to ca-certificates installation
RUN echo 'Acquire::https::Verify-Peer "false";' > /etc/apt/apt.conf.d/99ssl-trust && \
    echo 'Acquire::https::Verify-Host "false";' >> /etc/apt/apt.conf.d/99ssl-trust && \
    (sed -i 's/http:\/\//https:\/\//g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) && \
    (sed -i 's/deb.debian.org/mirrors.cloud.tencent.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) && \
    (sed -i 's/deb.debian.org/mirrors.cloud.tencent.com/g' /etc/apt/sources.list 2>/dev/null || true)

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone -b dev https://cdn.gh-proxy.org/https://github.com/CodeFindc/WrenAI.git /app || \
    git clone -b dev https://mirror.ghproxy.com/https://github.com/CodeFindc/WrenAI.git /app

# Remove .git history folder to save image space (~100-300MB)
RUN rm -rf /app/.git

WORKDIR /app/sdk/wren-langchain/examples/wren-chat-ui
RUN npm config set registry https://registry.npmmirror.com && \
    npm ci && npm run build && rm -rf node_modules

# Stage 2: Final lightweight python slim image (CN Accelerated Slim Base)
FROM python:3.11-slim

WORKDIR /app

RUN echo 'Acquire::https::Verify-Peer "false";' > /etc/apt/apt.conf.d/99ssl-trust && \
    echo 'Acquire::https::Verify-Host "false";' >> /etc/apt/apt.conf.d/99ssl-trust && \
    (sed -i 's/http:\/\//https:\/\//g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) && \
    (sed -i 's/deb.debian.org/mirrors.cloud.tencent.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true) && \
    (sed -i 's/deb.debian.org/mirrors.cloud.tencent.com/g' /etc/apt/sources.list 2>/dev/null || true)

ENV PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
ENV PIP_EXTRA_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_PREFER_BINARY=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=frontend-builder /app /app

RUN pip install --no-cache-dir --prefer-binary -i https://mirrors.cloud.tencent.com/pypi/simple -e /app/core/wren[all] && \
    cd /app/sdk/wren-langchain && \
    sed -i 's/wren-engine/wrenai/g' pyproject.toml && \
    pip install --no-cache-dir --prefer-binary -i https://mirrors.cloud.tencent.com/pypi/simple -e .[all] && \
    cd /app/sdk/wren-langchain/examples && \
    pip install --no-cache-dir -r requirements.txt && \
    apt-get purge -y --auto-remove build-essential git && \
    rm -rf /var/lib/apt/lists/* /tmp/* /root/.cache

WORKDIR /app/sdk/wren-langchain/examples
RUN chmod +x entrypoint.sh

EXPOSE 8201 8202

ENTRYPOINT ["./entrypoint.sh"]
CMD ["python3", "start_dual_services.py"]
