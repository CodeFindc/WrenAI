# ── OpenAI API Configurations ──────────────────────────────────────────
# ── OpenAI API Configurations ──────────────────────────────────────────
# 1. 指定使用云端/OpenAI 兼容的 Embedding 提供商
WREN_EMBEDDING_PROVIDER=openai

# 2. 指定您所使用的云端 Embedding 模型名称（如 text-embedding-3-small）
WREN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# 3. 配置 Embedding 的云端 API 地址（会拼接成 /embeddings 路径）
EM_OPENAI_BASE_URL=

# 4. 配置您的 Embedding API 密钥
EM_OPENAI_API_KEY=


# Required if using default ChatOpenAI configuration
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# ── General LLM Configurations ─────────────────────────────────────────
# Custom LLM endpoint if not using default OpenAI endpoints (optional)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o

# ── OpenAI-compatible Virtual Models & Thinking Process Stream ─────────────
# Comma-separated model ids returned by GET /v1/models (not the upstream LLM).
# Default: wren-agent,wren-semantic-analyst
OPENAI_EXPOSED_MODELS=wren-agent,wren-semantic-analyst

# Surface Wren agent ReAct reasoning/tool process to OpenAI clients like DEEIX-Chat.
# Modes: reasoning (default, emits delta.reasoning_content for UI thinking trace)
#        text (emits process inline into delta.content)
#        both (emits both reasoning_content and inline text)
#        off (emits only final response text)
OPENAI_PROCESS_STREAM_MODE=reasoning
OPENAI_PROCESS_MAX_TOOL_CHARS=400

# Keepalive for streaming connections during long idle windows (e.g., tool execution -> final LLM inference)
# OPENAI_SSE_KEEPALIVE_SECONDS: Keepalive interval in seconds (default: 15, set <= 0 to disable)
# OPENAI_SSE_KEEPALIVE_STYLE: 'comment' (default, ': keepalive\n\n') or 'empty_delta'
OPENAI_SSE_KEEPALIVE_SECONDS=15
OPENAI_SSE_KEEPALIVE_STYLE=comment

# ── Structured Logging & Diagnostics ──────────────────────────────────
# LOG_LEVEL: DEBUG | INFO (default) | WARNING | ERROR
LOG_LEVEL=INFO

# ── Persistent Chat History Store ──────────────────────────────────────
# Database connection URI for LangGraph multi-turn session persistence.
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Leave empty to fall back to safe in-memory MemorySaver checkpointer.
CHAT_HISTORY_DB_URI=

# ── Data Source Connection Profiles ─────────────────────────────────────
# These are automatically resolved inside entrypoint.sh to generate profiles.yml
ACTIVE_PROFILE=default
DATASOURCE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_database
DB_USER=root
DB_PASSWORD=secret
SSL_MODE=DISABLED

# Additional connection properties in JSON format (optional)
# e.g., EXTRA_PROFILE_KEYS={"ssl_mode":"DISABLED"}
EXTRA_PROFILE_KEYS=

# ── FunAI Custom Configurations ──────────────────────────────────────────
# 1. Custom directory for loading skills (defaults to PROJECT_PATH/.skills)
# FUNAI_SKILLS_PATH=D:\path\to\your\.skills

# 2. Custom base directory for isolated session directories (defaults to FunAI/sessions)
# FUNAI_SESSIONS_PATH=D:\path\to\your\sessions

# ── Track A FastMCP dual transport (port 8202) ──────────────────────────
# MCP_HOST=0.0.0.0
# MCP_PORT=8202
# Classic SSE path (Claude Desktop / older clients): GET /sse + POST /messages/
# MCP_SSE_PATH=/sse
# Streamable HTTP path (DEEIX-Chat baseURL): POST /mcp
# MCP_STREAMABLE_HTTP_PATH=/mcp

# ── Model Context Protocol (MCP) Tools Extension (Track B client) ───────
# Path to the directory containing .json files with MCP server definitions.
# These are external MCP servers that Track B's LangGraph agent can call —
# not the Track A server itself.
# MCP_CONFIG_DIR=./mcp_configs
