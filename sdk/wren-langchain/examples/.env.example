# ============================================================================
# WrenAI Dual-Track Example — Environment Variables
# Copy to `.env` and edit. See examples/README.md "Environment Variables
# Reference" for the full table. Variables marked (consumed) are read by
# langgraph_fastapi_multi.py / wren_mcp_server.py / entrypoint.sh /
# generate_profile.py; others flow into the generated profiles.yml.
# ============================================================================

# ── 1. Core Services & Network Binding ─────────────────────────────────────
# Path to the prepared Wren project directory (containing .wren/ + target/mdl.json).
PROJECT_PATH=./wren_project
# Track B FastAPI / OpenAI proxy port (/v1/* & /chat*).
PORT=8201
# Track A FastMCP dual-transport host/port + paths.
# MCP_HOST=0.0.0.0
# MCP_PORT=8202
# MCP_SSE_PATH=/sse
# MCP_STREAMABLE_HTTP_PATH=/mcp

# ── 2. Upstream LLM Configuration ───────────────────────────────────────────
# Chat model used by the LangGraph ReAct agent (Track B).
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
# Generic overrides — take precedence over OPENAI_* when set.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o
# Upstream LLM HTTP request timeout (seconds). Long tool-heavy turns with
# large contexts can exceed the old hard-coded 60s and get false-killed.
LLM_REQUEST_TIMEOUT=60

# ── 3. Embedding (memory layer) ─────────────────────────────────────────────
# Consumed by core/wren memory/embeddings.py when wren-engine[memory] is
# installed and .wren/memory/ is indexed. Provider "openai" points at an
# OpenAI-compatible embedding endpoint; otherwise falls back to the local
# sentence-transformers model.
WREN_EMBEDDING_PROVIDER=openai
WREN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EM_OPENAI_BASE_URL=
EM_OPENAI_API_KEY=

# ── 4. Track B OpenAI Adapter & Thinking Stream ────────────────────────────
# Comma-separated virtual model ids returned by GET /v1/models.
OPENAI_EXPOSED_MODELS=wren-agent,wren-semantic-analyst
# Surface ReAct reasoning/tool process to OpenAI clients (DEEIX-Chat).
# Modes: reasoning (default) | text | both | off
OPENAI_PROCESS_STREAM_MODE=reasoning
OPENAI_PROCESS_MAX_TOOL_CHARS=400

# ── 5. SSE Stream Keepalive ─────────────────────────────────────────────────
# Prevent client idle timeout during long tool/LLM inference windows.
OPENAI_SSE_KEEPALIVE_SECONDS=15
OPENAI_SSE_KEEPALIVE_STYLE=comment

# ── 6. Diagnostics & Persistence ───────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO (default) | WARNING | ERROR
LOG_LEVEL=INFO
# MySQL URI for persistent multi-turn history; empty → in-memory MemorySaver.
CHAT_HISTORY_DB_URI=
# Directory with JSON definitions for EXTERNAL MCP servers the Track B agent
# can call (not the Track A server itself).
# MCP_CONFIG_DIR=./mcp_configs

# ── 7. Automatic Data Source Profile (entrypoint.sh / generate_profile.py) ─
# Resolved into .wren/profiles.yml on first run.
ACTIVE_PROFILE=default
DATASOURCE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_database
DB_USER=root
DB_PASSWORD=secret
SSL_MODE=DISABLED
# JSON object of extra profile keys; nested dicts OK.
# e.g. EXTRA_PROFILE_KEYS={"kwargs":{"read_timeout":120},"ssl_mode":"DISABLED"}
EXTRA_PROFILE_KEYS=
# MySQL/Doris driver-level timeouts + pool (only injected for mysql/doris;
# the library injects no default timeout for MySQL otherwise).
# Set DB_PROFILE_TIMEOUTS=0 to skip the kwargs block entirely.
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=60
DB_WRITE_TIMEOUT=30
DB_MAX_CONNECTIONS=30
DB_PROFILE_TIMEOUTS=1

# ── 8. Containerized Claude CLI & Anthropic API Routing ──────────────────────
# Forwarding variables for docker-compose.claude.yaml & entrypoint.claude.sh
ANTHROPIC_AUTH_TOKEN=sk-dummy
ANTHROPIC_API_KEY=sk-dummy
ANTHROPIC_BASE_URL=http://192.168.110.209:8200/v1
ANTHROPIC_MODEL=Qwen3.6-27B-AEON-Ultimate-Uncensored-BF16

# Claude Code model alias overrides for local LLM routing
ANTHROPIC_DEFAULT_SONNET_MODEL=Qwen3.6-27B-AEON-Ultimate-Uncensored-BF16
ANTHROPIC_DEFAULT_HAIKU_MODEL=Qwen3.6-27B-AEON-Ultimate-Uncensored-BF16
ANTHROPIC_DEFAULT_OPUS_MODEL=Qwen3.6-27B-AEON-Ultimate-Uncensored-BF16
CLAUDE_CODE_SUBAGENT_MODEL=Qwen3.6-27B-AEON-Ultimate-Uncensored-BF16
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
